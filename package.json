{
  "name": "claude-talk-to-figma-mcp",
  "description": "Claude Desktop Talk to Figma MCP",
  "version": "0.9.0",
  "module": "dist/talk_to_figma_mcp/server.js",
  "main": "dist/talk_to_figma_mcp/server.js",
  "bin": {
    "claude-talk-to-figma-mcp": "scripts/launcher.js",
    "claude-talk-to-figma-mcp-server": "dist/talk_to_figma_mcp/server.js",
    "claude-talk-to-figma-mcp-socket": "dist/socket.js"
  },
  "files": [
    "dist",
    "scripts/launcher.js",
    "src/claude_mcp_plugin/manifest.json",
    "readme.md",
    "LICENSE",
    "TESTING.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "scripts": {
    "start": "bun run dist/talk_to_figma_mcp/server.js",
    "socket": "bun run dist/socket.js",
    "setup": "./scripts/setup.sh",
    "build": "rm -rf dist && bun build --target=node --format=esm --outdir=dist ./src/talk_to_figma_mcp/server.ts ./src/socket.ts && chmod +x dist/talk_to_figma_mcp/server.js dist/socket.js",
    "build:cjs": "rm -rf dist && bun build --target=node --format=cjs --outdir=dist ./src/talk_to_figma_mcp/server.ts ./src/socket.ts",
    "dev": "bun run --watch src/talk_to_figma_mcp/server.ts",
    "pack": "dxt pack",
    "sync-version": "VERSION=$(jq -r '.version' package.json) && jq --arg version \"$VERSION\" '.version = $version' manifest.json > manifest.tmp && mv manifest.tmp manifest.json",
    "build:dxt": "bun run sync-version && bun run build:cjs && bun run pack",
    "pub:release": "bun run build && npm publish",
    "configure-claude": "node scripts/configure-claude.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "node scripts/test-integration.js",
    "lint": "biome check"
  },
  "devDependencies": {
    "@anthropic-ai/dxt": "^0.2.6",
    "@biomejs/biome": "^2.4.4",
    "@types/bun": "latest",
    "@types/jest": "^30.0.0",
    "bun-types": "^1.3.10",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "uuid": "^13.0.0",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "keywords": [
    "claude",
    "figma",
    "mcp",
    "plugin",
    "ai",
    "design",
    "automation"
  ],
  "author": "Xúlio Zé",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arinspunk/claude-talk-to-figma-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/arinspunk/claude-talk-to-figma-mcp/issues"
  },
  "homepage": "https://github.com/arinspunk/claude-talk-to-figma-mcp#readme"
}
